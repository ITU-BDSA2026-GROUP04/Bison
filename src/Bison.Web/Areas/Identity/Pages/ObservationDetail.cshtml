@page "/ob/{id}"
@using System.Data.Common
@model Bison.Web.Pages.ObservationDetailModel
@{
    ViewData["Title"] = "Model";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("id");
}

<div>
    <h2> Observation @routeName </h2>

    <h3>
    <p class="observations">
        <strong>
            <a href="/@Model.Observations.Author">@Model.Observations.Author</a>
            </strong>
            @Model.Observations.Message
            <small>&mdash; @Model.Observations.Timestamp</small>
    </p>
    </h3>

    <!--Comment-->
    <h3>Comments<h3/>
    @if (Model.Observations.Comment != null && Model.Observations.Comment.Any())
        {
            <ul id = "messagelist" class="observations">
            @foreach(var ob in Model.Observations.Comment)
                {
                   <li>
                    <p>
                        <strong>
                            <a href = "/@(ob.Author?.UserName?? "Unknown")"> @(ob.Author?.UserName?? "Unknown")</a>
                        </strong>
                        @ob.Text
                        <small>&mdash;@ob.TimeStamp.ToString("dd/MM/yyyy HH:mm")</small>
                    </p>
                    </li>
                }  
            </ul>
        }
        else
        {
            <em>No comments</em>
        }
    
    @if(User.Identity?.IsAuthenticated == true)
        {
            <div class="observationbox" style="margin-top: 20px;">
                <h4>Add a comment</h4>
                <form method="post" asp-page-handler="Comment" asp-route-id="@RouteData.Values["id"]">
                    <input type="text" asp-for="comment" placeholder="Comment..." required />
                    <input type="submit" value="Comment" />
                </form>
            </div>
        }

    <!--Proposal-->
    <h3>Proposals<h3/>
    @if (Model.Observations.Proposals != null || Model.Observations.Proposals.Any())
            {
                <ul id = "messagelist" class="observations">
            @foreach(var ob in Model.Observations.Proposals)
                {
                   <li>
                    <p>
                        <strong>
                            <a href = "/@(ob.Author?.UserName?? "Unknown")"> @(ob.Author?.UserName?? "Unknown")</a>
                        </strong>
                        @ob.Text
                        <small>&mdash;@ob.TimeStamp.ToString("dd/MM/yyyy HH:mm")</small>
                    </p>
                    </li>
                }  
            </ul>
            }
            else
            {
                <em>No proposals</em>
            }


    @if(User.Identity?.IsAuthenticated == true)
        {
            <div class="observationbox" style="margin-top: 20px;">
                <h4>Add proposal</h4>
                <form method="post" asp-page-handler="Proposal" asp-route-id="@RouteData.Values["id"]">
                    <input type="text" asp-for="proposal" placeholder="Proposals..." required />
                    <input type="submit" value="Propose" />
                </form>
            </div>
        }

else{
    <em>No proposals</em>
}
</div>

    

    