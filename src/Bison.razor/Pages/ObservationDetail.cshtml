@page "/ob/{id}"
@model Bison.Razor.Pages.ObservationDetailModel
@{
    ViewData["Title"] = "Model";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("id");
}

<div>
    <h2> Observation @routeName </h2>

    <h3>
    <p class="observations">
        <strong>
            <a href="/@Model.Observations.Author">@Model.Observations.Author</a>
            </strong>
            @Model.Observations.Message
            <small>&mdash; @Model.Observations.Timestamp</small>
    </p>
    </h3>
    

    @if (!Model.Observations.Message.Equals(""))
    {
        @if (Model.Observations.Comment != null && Model.Observations.Comment.Any()) 
        {
            <h4><strong>Comments</strong></h4>
            <ul id="messagelist" class="observations">
                @foreach (var ob in Model.Observations.Comment)
                {
                    <li>
                        <p>
                            <strong>
                                <a href="/@ob.Author">@ob.Author</a>
                            </strong>
                            @ob.Message
                            <small>&mdash; @ob.Timestamp</small>
                        </p>
                    </li>
                }
            </ul>
        }
        else
        {
            <em>There are no comments so far.</em>
        }
    } else {
        <em>This observation does not exist.</em>
    }
    
</div>
