<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"]</title>
    <link href="/css/style.css" rel="stylesheet" type="text/css" />
    <link rel="icon" type="image/png" href="/favicon/favicon.ico">
</head>
<body>
<div class=navigation>
    <partial name="_LoginPartial" /> 
    @if (User.Identity.IsAuthenticated)
    {
    <div>
    <a href="/@(User.Identity.Name)">My Observations</a> |
    <a href="/">Public Observations</a> |
    <a ... >Logout [@(User.Identity.Name)]</a>
    </div>
    }
    else
    {
    <div>
    </div>
    <a href="/">Public Observations</a>
    }
</div>
<div class=page>
    <h1><img src="/images/icon1.png" alt="Icon1"/>Bison</h1>
    <div class=body>
            @RenderBody()
    </div>
    <footer class="footer text-muted">
        <div class="container">
            &copy; Bison &mdash; An ASP.NET Application Built from commit: c07308e9784853ff127337f7328a660360dddfc6
        </div>
    </footer>
</div>

</body>
@await RenderSectionAsync("Scripts", required: false)
</html>
