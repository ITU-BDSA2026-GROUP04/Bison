@page "/{ob?}"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <!--Public Timeline-->
    <h2> Public Observations </h2>

    <!--Observation box displayed for authenticated users-->
     <!-- Skeleton for observation box from assignment sheet-->
    @if(User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class = "observationbox">
            <h3>What did you see, @(User.Identity.Name)?</h3>
            <form method="post">
                <input style="float: left" type="text" asp-for="Text" required>
                <input type="text" asp-for="ImageURL" placeholder="Image URL (optional)" />
                <input type="hidden" asp-for="TaxonId" value="1" />
                <input type="submit" value="Share">
            </form>
        </div>
    }
    

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                        @obs.Message
                        <small>&mdash; @obs.Timestamp</small>
                        <br />
                        <small><a href="/obs/taxons/@obs.TaxonId">@(obs.Taxon?.VernacularName ?? "Unknown")</a></small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>
