@page "/{ob?}"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <!--Public Timeline-->
    <h2> Public Observations </h2>

    <!--Observation box displayed for authenticated users-->
    @if(User.Identity != null && User.Identity.IsAuthenticated)
    {
        
    }
    

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                        @obs.Message
                        <small>&mdash; @obs.Timestamp</small>
                        <br />
                        <small><a href="/obs/taxons/@obs.TaxonId">@(obs.Taxon?.VernacularName ?? "Unknown")</a></small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>
